// Tribal Gaming Compliance & Licensing Platform — data model
// Reconciled against: prototype HTML/JS (source of the UX), the PRD (V1),
// the Data Model Gap Analysis, and the Access-Control Model V1 Draft Proposal.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth / roles (R4)
// ---------------------------------------------------------------------------

enum Role {
  COMPLIANCE
  LICENSING
  APPLICANT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  // For an APPLICANT user, scopes them to exactly one Person profile (R9.3).
  personId     String?  @unique
  person       Person?  @relation(fields: [personId], references: [id])
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Floor Map (R2) — Areas / Banks / Machines
// ---------------------------------------------------------------------------

// Singleton row holding the manually-expandable canvas width ("Expand
// Width" control). The effective width used for layout is always
// max(mapWidth, extent implied by current bank positions) — auto-grow from
// dragging banks near the edge never needs to persist here.
model MapSettings {
  id       Int @id @default(1)
  mapWidth Int @default(1560)
}

model Area {
  id    String     @id @default(cuid())
  key   String     @unique
  label String
  // y/h are display-layer state for the pannable/zoomable canvas. Kept
  // persisted (not derived) so the layout survives across demo sessions —
  // see Data Model Gap Analysis: "purely a UI/display convenience layered
  // on top of Area / Bank" is the resolution taken here, but persisted.
  y     Int
  h     Int
  order Int        @default(0)
  banks Bank[]
  // Set on the band created for an imported CAD floor plan (one plan per area).
  plan  FloorPlan?
}

// A floor plan imported from AutoCAD (DXF). Lives in its own Area band below
// the existing areas, so importing one never moves or replaces existing banks.
// `outline` is a list of closed rings — [[x, y], ...] in canvas px, relative to
// (originX, area.y + padding) so it stays attached when areas above are resized.
// Rings are drawn even-odd, which is how courtyards / cut-outs are expressed.
model FloorPlan {
  id         String   @id @default(cuid())
  name       String
  sourceFile String   @default("")
  units      String?
  scale      Float    @default(1) // canvas px per drawing unit at import time
  areaId     String   @unique
  area       Area     @relation(fields: [areaId], references: [id])
  originX    Int      @default(40)
  width      Int
  height     Int
  outline    Json
  banks      Bank[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Bank {
  id        String    @id @default(cuid())
  name      String
  areaId    String
  area      Area      @relation(fields: [areaId], references: [id])
  x         Int
  y         Int
  capacity  Int
  machines  Machine[]
  createdAt DateTime  @default(now())

  // Optional per-bank card size. Null keeps the default BANK_W look, so every
  // pre-existing bank renders exactly as before. Set by CAD import (from the
  // footprint) or by the manual resize control.
  w         Int?
  h         Int?
  // Exact CAD footprint polygon, [[x, y], ...] relative to the card's top-left.
  footprint Json?
  planId    String?
  plan      FloorPlan? @relation(fields: [planId], references: [id])
  // Stable id within the plan (DXF handle or label) so re-importing an edited
  // drawing updates banks in place instead of duplicating them.
  cadRef    String?

  @@unique([planId, cadRef])
}

enum ComplianceStatus {
  VERIFIED
  FLAGGED
  PENDING
}

// Lifecycle + Highlight/Flag mirror the "live" Machine Records vocabulary
// surfaced in the Data Model Gap Analysis. Added alongside ComplianceStatus
// (not replacing it) — see plan confirmation with project owner.
enum LifecycleStatus {
  ACTIVE
  IN_TRANSIT
  OUT_OF_SERVICE
  CONVERTED
  RETIRED
}

enum HighlightFlag {
  NONE
  CONVERSION_PROJECT
  REVOCATION
}

model Machine {
  id               String           @id @default(cuid())
  serial           String           @unique // e.g. EGD-10412
  assetNumber      String
  manufacturer     String
  model            String
  theme            String
  parSheet         String
  sealNumber       String           @default("")
  complianceStatus ComplianceStatus @default(PENDING)
  lifecycleStatus  LifecycleStatus  @default(ACTIVE)
  highlightFlag    HighlightFlag    @default(NONE)
  softwareStatus   String           @default("Compliant") // Compliant / Needs Update / Conditionally Revoked / Revoked
  statusSince      DateTime         @default(now())

  bankId    String?
  bank      Bank?   @relation(fields: [bankId], references: [id])
  seatIndex Int?

  documents MachineDocument[]
  history   MachineHistory[]
  shipments ShipmentMachine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Archive / Restore ---------------------------------------------------
  // Archiving clears bankId/seatIndex (same shape as removing from a seat) so
  // the machine drops off the floor map and active list for free; priorBankId
  // is a plain id (no relation) so restore can still fall back to Unassigned
  // if that bank was deleted while archived, without a broken FK in between.
  archived       Boolean   @default(false)
  archivedAt     DateTime?
  archivedBy     String?
  restoredAt     DateTime?
  restoredBy     String?
  priorBankId    String?
  priorSeatIndex Int?

  @@unique([bankId, seatIndex])
}

model MachineDocument {
  id        String   @id @default(cuid())
  machineId String
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  name      String
  blobUrl   String?
  date      DateTime @default(now())
}

model MachineHistory {
  id        String   @id @default(cuid())
  machineId String
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  event     String
}

// Map-level audit stream — separate from per-machine history, matching the
// prototype's "Recent Map Changes" log and the live Floor Map Planning
// Change Type field (Move Bank / Add Machines / Remove Machines / Other).
model MapChangeLog {
  id         String   @id @default(cuid())
  changeType String
  bankName   String
  areaLabel  String
  notes      String
  ts         DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Shipment Management (R3)
// ---------------------------------------------------------------------------

model Shipment {
  id                   String              @id @default(cuid())
  // Nullable-free at the DB level (same tradeoff as Machine.sealNumber): a
  // default backfills any pre-existing row cleanly, while the create form
  // enforces both as required going forward.
  type                 String              @default("Inbound") // Inbound / Outbound
  vendor               String              @default("") // Vendor / Shipper — distinct from the freight carrier below
  carrier              String
  // Renamed at the Prisma layer only — the DB column stays "received" via
  // @map so this needs no backfill/rename migration, just a field rename.
  shippingDate         DateTime            @map("received")
  estimatedArrivalDate DateTime?
  status               String // Open / Processing / Closed
  documents            ShipmentDocument[]
  extracted            ShipmentField[]
  notify               ShipmentRecipient[]
  machines             ShipmentMachine[]
  createdAt            DateTime            @default(now())
}

model ShipmentDocument {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  name       String
  blobUrl    String?
  date       DateTime @default(now())
}

// AI document-scrubbing output — structured key/value pairs. A row starts
// PROPOSED on document upload (editable, not yet trusted) and moves to
// ACCEPTED once a human reviews and confirms it; only ACCEPTED rows count as
// the shipment's extracted fields. Defaulting to ACCEPTED keeps pre-existing
// rows (seeded before this status existed) behaving exactly as before.
enum ExtractionStatus {
  PROPOSED
  ACCEPTED
}

model ShipmentField {
  id         String           @id @default(cuid())
  shipmentId String
  shipment   Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  key        String
  value      String
  status     ExtractionStatus @default(ACCEPTED)
  // Simulated OCR/LLM confidence (0–1). Drives whether an accepted field is
  // also auto-applied to the shipment record / linked machines, vs. staying
  // informational only for a human to reconcile by hand.
  confidence Float?
}

model ShipmentRecipient {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  email      String
  sent       Boolean  @default(false)
}

// Many-to-many: a shipment can carry several machines, and a machine can
// appear on more than one shipment over its lifetime (e.g. inbound install,
// later outbound return). Cascades from both sides so deleting either a
// shipment or a machine record cleans up the link with it.
model ShipmentMachine {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  machineId  String
  machine    Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([shipmentId, machineId])
}

// ---------------------------------------------------------------------------
// Self-Exclusion Module (R5) — sensitive, fabricated demo data only
// ---------------------------------------------------------------------------

model Exclusion {
  id        String              @id @default(cuid())
  // Collapses the workspace's two parallel status fields (Status,
  // Exclusion Status) into one, per the field-expansion task's own note.
  // Active / Expired / Removed / Under Review
  status    String
  enrolled  DateTime
  term      String
  photoUrl  String?
  documents ExclusionDocument[]
  notes     ExclusionNote[]
  archived  Boolean             @default(false)
  createdAt DateTime            @default(now())

  // --- Archive / Restore Audit ---------------------------------------------
  // Last archive/restore event, independent of the current `archived` value,
  // so re-archiving after a restore doesn't erase who restored it (or vice
  // versa).
  archivedAt DateTime?
  archivedBy String?
  restoredAt DateTime?
  restoredBy String?

  // --- Person Identification ---------------------------------------------
  // Nullable at the database level so this migration needs no backfill step;
  // enforced as required by the create form, since a self-exclusion record
  // that cannot name who it excludes cannot do its job.
  personName   String?
  aliases      String?
  dateOfBirth  DateTime?
  governmentId String? // "Government / Tribal ID"

  // --- Exclusion Details ---------------------------------------------------
  exclusionType   String? // Self-Exclusion / Involuntary Exclusion / Other
  expirationDate  DateTime?
  restrictions    String? // "Restrictions / Terms"
  sourceInitiated String? // "Source / How Initiated"

  // --- System & Audit -------------------------------------------------------
  // Stamped from the acting user's session name rather than a User relation,
  // so the record preserves who acted even if that account is later removed.
  createdBy      String?
  lastModifiedBy String?
  updatedAt      DateTime @updatedAt
}

model ExclusionDocument {
  id          String    @id @default(cuid())
  exclusionId String
  exclusion   Exclusion @relation(fields: [exclusionId], references: [id], onDelete: Cascade)
  name        String
  blobUrl     String?
  date        DateTime  @default(now())
}

model ExclusionNote {
  id          String    @id @default(cuid())
  exclusionId String
  exclusion   Exclusion @relation(fields: [exclusionId], references: [id], onDelete: Cascade)
  date        DateTime  @default(now())
  event       String
}

// ---------------------------------------------------------------------------
// Licensing (R6) / Applicant Portal (R9)
// ---------------------------------------------------------------------------

// Drives the Licensing list's status folders/tabs. "Critical docs incomplete"
// is a separate, computed smart folder (profiles missing Notice of Results,
// No-Objection, and/or Issuance) — deliberately not a value here, since a
// profile's status and its document completeness are independent facts.
enum LicensingApplicationStatus {
  APPLICATION_NOT_FINISHED
  APPLICATION_TURNED_IN
  READY_TO_REVIEW
  APPROVED
  TEMPORARY_LICENSE
  LICENSED_WITH_CONDITIONS
  DENIED
  WITHDRAWN
  SEPARATED
}

model Person {
  id        String           @id @default(cuid())
  // Already serves as the workspace's "Full Legal Name" field — the seeded
  // records store full names, and there is no separate short-label use of
  // this field elsewhere, so no rename was needed to close that gap.
  name      String
  role      String // e.g. "Applicant — Key Employee", "Vendor — Gaming Equipment"
  status    String // cleared / flagged / investigation
  photoUrl  String?
  documents PersonDocument[]
  history   PersonHistory[]
  user      User?
  archived  Boolean          @default(false)
  createdAt DateTime         @default(now())

  // --- Vendor Licensing ------------------------------------------------------
  // Set when this profile is a principal of a vendor company (Vendor
  // Licensing module); null for a standalone/individual licensee.
  vendorCompanyId String?
  vendorCompany   VendorCompany? @relation(fields: [vendorCompanyId], references: [id])

  // The Application this profile was created from via Accept, if any.
  application Application?

  // --- Archive / Restore Audit ---------------------------------------------
  // Last archive/restore event, independent of the current `archived` value,
  // so re-archiving after a restore doesn't erase who restored it (or vice
  // versa).
  archivedAt DateTime?
  archivedBy String?
  restoredAt DateTime?
  restoredBy String?

  // --- Identification -------------------------------------------------------
  dateOfBirth DateTime?
  contactInfo String? // phone / email / address, combined per the workspace's Contact Info field
  // Prefill field for the static forms pass (Suitability determination,
  // Notice of results, Issuance of license, Denial letter) — stored as
  // entered (e.g. "XXX-XX-1234") rather than parsed/validated, since this
  // is a fixed-template prefill value, not a field the app itself computes.
  ssn         String?

  // --- Position & Job Description --------------------------------------------
  // Prefill field for the same static forms pass — see ssn above.
  position       String?
  jobDescription String?

  // --- License --------------------------------------------------------------
  licenseType           String? // Employee / Vendor / Key / Other
  licenseNumber         String?
  licenseIssueDate      DateTime?
  licenseExpirationDate DateTime?

  // --- Application & Status ---------------------------------------------------
  applicationDate          DateTime?
  applicationStatus        LicensingApplicationStatus?
  backgroundStatus         String? // Not Started / In Review / Approved / Denied / Needs Info
  suitabilityDetermination String? // Pending / Suitable / Unsuitable

  // --- Investigation Tracking ------------------------------------------------
  // Free text rather than a User relation: there is no investigator
  // directory in this app, only the three demo role accounts.
  assignedInvestigator        String?
  investigationStartDate      DateTime?
  investigationCompletionDate DateTime?
  keyFindings                 String?

  // --- System & Audit ----------------------------------------------------------
  createdBy      String?
  lastModifiedBy String?
  updatedAt      DateTime @updatedAt
}

// Fixed 11-slot Licensing document checklist (R6), plus BACKGROUND_CHECK —
// rendered as its own labeled box rather than a checklist grid slot (see
// BACKGROUND_CHECK_SLOT in src/lib/document-slots.ts) and reserved as the
// only slot a future background-check vendor integration may write to
// (see addBackgroundCheckDocumentAction in src/lib/actions/people.ts).
// Nullable so the field doesn't force a backfill and an Applicant Portal
// submission with no Licensing-assigned category still has somewhere to live.
enum DocumentSlot {
  APPLICATION
  ID_PHOTO
  SSN_CARD
  CRIMINAL_HISTORY
  FINGERPRINTS
  INVESTIGATIVE_REPORT
  SUITABILITY_REPORT
  NOTICE_OF_RESULTS
  NO_OBJECTION_LETTER
  LICENSE_ISSUANCE
  DENIAL_LETTER
  NIGC_RECEIPT
  BACKGROUND_CHECK
  LICENSING_ACTIONS
  SEPARATION_NOTICE
}

model PersonDocument {
  id        String        @id @default(cuid())
  personId  String
  person    Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  name      String
  slot      DocumentSlot?
  blobUrl   String?
  date      DateTime?
  submitted Boolean       @default(true)
}

model PersonHistory {
  id       String   @id @default(cuid())
  personId String
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  date     DateTime @default(now())
  event    String
}

// ---------------------------------------------------------------------------
// Vendor Licensing — vendor companies and their principals (Licensing side)
// ---------------------------------------------------------------------------
// A VendorCompany is the licensed entity; its principals are ordinary Person
// profiles (Person.vendorCompanyId) so a principal's profile is exactly the
// same shape — same fields, same checklist pattern — as any other licensee.

model VendorCompany {
  id          String  @id @default(cuid())
  name        String
  status      String // cleared / flagged / investigation — same vocabulary as Person.status
  contactInfo String?
  address     String?

  licenseType           String?
  licenseNumber         String?
  licenseIssueDate      DateTime?
  licenseExpirationDate DateTime?

  principals   Person[]
  applications Application[]

  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?
  restoredAt DateTime?
  restoredBy String?

  createdBy      String?
  lastModifiedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Applications — invite-to-accept pipeline that feeds Person on Accept
// ---------------------------------------------------------------------------
// Mirrors the Person intake shape field-for-field so Accept can copy every
// field across as-is ("ALL application fields prefilled") with no mapping.

model Application {
  id       String @id @default(cuid())
  progress String // Invited / In Progress / Submitted / Accepted / Rejected

  name        String
  email       String
  role        String
  dateOfBirth DateTime?
  contactInfo String?

  position       String?
  jobDescription String?

  licenseType           String?
  licenseNumber         String?
  licenseIssueDate      DateTime?
  licenseExpirationDate DateTime?

  applicationDate          DateTime?
  applicationStatus        LicensingApplicationStatus?
  backgroundStatus         String?
  suitabilityDetermination String?

  assignedInvestigator        String?
  investigationStartDate      DateTime?
  investigationCompletionDate DateTime?
  keyFindings                 String?

  // Set when this application is for a principal of a vendor company —
  // surfaces it as a "needs application" / pending entry on that company's
  // Vendor Licensing detail page until Accepted.
  vendorCompanyId String?
  vendorCompany   VendorCompany? @relation(fields: [vendorCompanyId], references: [id])

  // Set on Accept, once the Person profile is created from this application.
  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id])

  invitedBy   String?
  invitedAt   DateTime  @default(now())
  submittedAt DateTime?
  acceptedAt  DateTime?
  acceptedBy  String?
  rejectedAt  DateTime?
  rejectedBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
